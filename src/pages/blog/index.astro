---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../utils/url';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base title="Blog" description="Blog posts by Divye Kalra on security, homelabs, and engineering.">
  <section class="py-12">
    <p class="mono-label reveal reveal-1 mb-2">~/blog</p>
    <h1 class="reveal reveal-2 font-mono text-3xl font-semibold tracking-tight">Blog</h1>

    {
      posts.length === 0 ? (
        <p class="reveal reveal-3 mt-8 font-mono text-sm text-[var(--text-muted)]">
          # nothing here yet — longer-form notes live in <a href={url('/notes/')} class="text-[var(--accent)] underline underline-offset-4">~/notes</a>
        </p>
      ) : (
        <ul class="reveal reveal-3 mt-10 space-y-6">
          {posts.map((post) => (
            <li>
              <a href={url(`/blog/${post.id}/`)} class="card group block p-5">
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                  <h2 class="font-mono text-lg font-medium group-hover:text-[var(--accent)]">
                    {post.data.title}
                  </h2>
                  <span class="font-mono text-xs text-[var(--text-muted)]">
                    {post.data.pubDate.toISOString().slice(0, 10)}
                  </span>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">
                  {post.data.description}
                </p>
                {post.data.tags.length > 0 && (
                  <div class="mt-3 flex flex-wrap gap-2 font-mono text-[11px] text-[var(--text-muted)]">
                    {post.data.tags.map((t) => (
                      <span>#{t}</span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Base>
