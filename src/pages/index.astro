---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { series, seriesOrder } from '../data/series';
import { url } from '../utils/url';

const notes = await getCollection('notes');
const blogPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const projectNotes = notes
  .filter((n) => n.data.series === 'projects')
  .sort((a, b) => a.data.order - b.data.order);

const noteCounts = Object.fromEntries(
  seriesOrder.map((id) => [id, notes.filter((n) => n.data.series === id).length])
);
---

<Base title="Divye Kalra">
  <!-- hero -->
  <section class="py-14 sm:py-20">
    <p class="mono-label reveal reveal-1 mb-4">$ whoami</p>
    <div class="flex flex-col-reverse items-start gap-8 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-xl">
        <h1 class="reveal reveal-2 font-mono text-4xl font-semibold tracking-tight sm:text-5xl">
          Divye Kalra<span class="cursor-blink" aria-hidden="true"></span>
        </h1>
        <p class="reveal reveal-3 mt-4 text-lg text-[var(--text-muted)]">
          SDE Intern @ <span class="text-[var(--text)]">GlobalLogic Inc.</span> Previously a vehicle
          security researcher at JHU Applied Physics Laboratory. Cybersecurity graduate from Johns Hopkins
          University.
        </p>
        <div class="reveal reveal-3 mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-sm text-[var(--text-muted)]">
          <span><span class="text-[var(--accent)]">⌖</span> Livermore, CA</span>
          <a class="transition-colors hover:text-[var(--accent)]" href="https://github.com/divyekalra1" target="_blank" rel="noopener">github ↗</a>
          <a class="transition-colors hover:text-[var(--accent)]" href="https://www.linkedin.com/in/divyekalra1/" target="_blank" rel="noopener">linkedin ↗</a>
          <a class="transition-colors hover:text-[var(--accent)]" href="https://scholar.google.com.au/citations?user=1n8desUAAAAJ" target="_blank" rel="noopener">scholar ↗</a>
        </div>
        <div class="reveal reveal-4 mt-6 flex flex-wrap gap-2 font-mono text-xs">
          {
            ['cryptography', 'network security', 'distributed systems', 'C-V2X', 'pentesting'].map((t) => (
              <span class="rounded-full border border-[var(--border)] px-3 py-1 text-[var(--text-muted)]">
                {t}
              </span>
            ))
          }
        </div>
      </div>
      <img
        src={url('/photo.jpeg')}
        alt="Divye Kalra"
        width="160"
        height="160"
        class="reveal reveal-2 h-32 w-32 rounded-xl border border-[var(--border)] object-cover sm:h-40 sm:w-40"
      />
    </div>
  </section>

  <!-- about -->
  <section class="reveal reveal-4 border-t border-[var(--border)] py-12">
    <p class="mono-label mb-5">cat about.md</p>
    <div class="space-y-4 leading-relaxed text-[var(--text-muted)]">
      <p>
        I'm currently a software development engineering intern at GlobalLogic Inc. Before that, I worked
        on cybersecurity and assurance challenges in connected and automated vehicles (CAVs) at Johns
        Hopkins University and the Applied Physics Laboratory, under
        <a class="link-accent" href="https://engineering.jhu.edu/faculty/anton-dahbura/">Dr. Anton Dahbura</a>,
        <a class="link-accent" href="https://engineering.jhu.edu/faculty/krishan-sabnani/">Dr. Krishan Sabnani</a>,
        and Dr. Ilya Sabnani — including integrating C-V2X communication into VESNOS to strengthen the
        Secure Credential Management System (SCMS) and reduce communication latency.
      </p>
      <p>
        Previously, I was a visiting researcher at the
        <a class="link-accent" href="https://trustlab.iitb.ac.in/">IITB Trust Lab</a> (IIT Bombay) under
        <a class="link-accent" href="https://www.cse.iitb.ac.in/~mp/">Prof. Manoj Prabhakaran</a>, implementing
        CASE (Completely Anonymous Signed Encryption) in Rust and contributing to ECAS optimizations. Before
        that, I researched secure multi-party computation with Trusted Execution Environments,
        privacy-preserving query systems, and cryptographic system design at Macquarie University's Cyber
        Security Hub under
        <a class="link-accent" href="https://researchers.mq.edu.au/en/persons/dali-kaafar">Dr. Dali Kaafar</a>.
      </p>
    </div>
    <div class="mt-6 flex flex-wrap gap-4 font-mono text-sm">
      <a
        href={url('/divye-kalra-resume.pdf')}
        class="rounded-md border border-[var(--accent)] px-4 py-2 text-[var(--accent)] transition-colors hover:bg-[var(--accent)] hover:text-[var(--bg)]"
        >resume.pdf ↓</a
      >
      <a
        href={url('/publications/')}
        class="rounded-md border border-[var(--border)] px-4 py-2 text-[var(--text-muted)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
        >publications →</a
      >
    </div>
  </section>

  <!-- projects strip -->
  {
    projectNotes.length > 0 && (
      <section class="border-t border-[var(--border)] py-12">
        <p class="mono-label mb-5">ls ~/projects</p>
        <div class="grid gap-4 sm:grid-cols-2">
          {projectNotes.map((note) => (
            <a href={url(`/notes/${note.id}/`)} class="card group block p-5">
              <h3 class="font-mono text-base font-medium group-hover:text-[var(--accent)]">
                {note.data.title}
              </h3>
              {note.data.description && (
                <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">
                  {note.data.description}
                </p>
              )}
              <div class="mt-3 flex flex-wrap gap-2 font-mono text-[11px] text-[var(--text-muted)]">
                {note.data.tags.slice(0, 4).map((t) => (
                  <span>#{t}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- notes series -->
  <section class="border-t border-[var(--border)] py-12">
    <p class="mono-label mb-5">ls ~/notes</p>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        seriesOrder
          .filter((id) => id !== 'projects' && noteCounts[id] > 0)
          .map((id) => (
            <a href={url(`/notes/#${id}`)} class="card group block p-5">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-mono text-base font-medium group-hover:text-[var(--accent)]">
                  {series[id].name}
                </h3>
                <span class="font-mono text-xs text-[var(--text-muted)]">
                  {noteCounts[id]} {noteCounts[id] === 1 ? 'note' : 'notes'}
                </span>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{series[id].blurb}</p>
            </a>
          ))
      }
    </div>
  </section>

  <!-- recent blog posts -->
  {
    blogPosts.length > 0 && (
      <section class="border-t border-[var(--border)] py-12">
        <p class="mono-label mb-5">tail -3 ~/blog</p>
        <ul class="space-y-3">
          {blogPosts.slice(0, 3).map((post) => (
            <li>
              <a
                href={url(`/blog/${post.id}/`)}
                class="group flex items-baseline justify-between gap-4 py-1"
              >
                <span class="font-medium transition-colors group-hover:text-[var(--accent)]">
                  {post.data.title}
                </span>
                <span class="shrink-0 font-mono text-xs text-[var(--text-muted)]">
                  {post.data.pubDate.toISOString().slice(0, 10)}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .link-accent {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
    text-underline-offset: 3px;
  }
  .link-accent:hover {
    text-decoration-color: var(--accent);
  }
</style>
