---
import type { CollectionEntry } from 'astro:content';
import { url } from '../utils/url';

interface Props {
  seriesName: string;
  notes: CollectionEntry<'notes'>[];
  currentId: string;
}

const { seriesName, notes, currentId } = Astro.props;
---

<aside class="hidden w-56 shrink-0 lg:block">
  <nav class="sticky top-8">
    <p class="mono-label mb-3">{seriesName}</p>
    <ul class="space-y-0.5 border-l border-[var(--border)] text-sm">
      {
        notes.map((n) => (
          <li>
            <a
              href={url(`/notes/${n.id}/`)}
              class:list={[
                '-ml-px block border-l py-1 pl-3 leading-snug transition-colors',
                n.id === currentId
                  ? 'border-[var(--accent)] font-medium text-[var(--accent)]'
                  : 'border-transparent text-[var(--text-muted)] hover:border-[var(--text-muted)] hover:text-[var(--text)]',
              ]}
            >
              {n.data.title}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>
