---
interface Link {
  href: string;
  title: string;
}

interface Props {
  prev?: Link;
  next?: Link;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="mt-12 grid gap-4 border-t border-[var(--border)] pt-8 sm:grid-cols-2">
      {prev ? (
        <a href={prev.href} class="card group block p-4">
          <p class="mono-label mb-1">← prev</p>
          <p class="text-sm font-medium group-hover:text-[var(--accent)]">{prev.title}</p>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a href={next.href} class="card group block p-4 text-right">
          <p class="mono-label mb-1">next →</p>
          <p class="text-sm font-medium group-hover:text-[var(--accent)]">{next.title}</p>
        </a>
      )}
    </nav>
  )
}
